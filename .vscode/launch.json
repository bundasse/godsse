{
  // 실행/디버그 구성. VS Code 의 "실행 및 디버그" 패널에서 목록에 나타난다.
  // 빌드·테스트 같은 반복 작업은 .vscode/tasks.json 에 있고, 여기서는 "실행"만 담당한다.
  "version": "0.2.0",
  "configurations": [
    {
      // 백엔드(Spring Boot)를 디버그 모드로 실행한다.
      // Java 확장(redhat.java)이 저장된 코드를 자동으로 컴파일하므로 별도 빌드가 필요 없다.
      // cwd 를 backend 로 잡는 이유: application.properties 의 DB 경로(./data/godsse)가
      // 실행 폴더 기준 상대 경로이기 때문이다. (루트에서 실행하면 godsse/data 에 생긴다)
      "type": "java",
      "name": "백엔드: 실행 (Spring Boot)",
      "request": "launch",
      "mainClass": "com.godsse.backend.GodsseBackendApplication",
      "cwd": "${workspaceFolder}/backend",
      // 내장 터미널에 로그를 보여 주고, 기동이 끝나면 /api/hello 를 브라우저로 연다.
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Started GodsseBackendApplication .*",
        "uriFormat": "http://localhost:8080/api/hello",
        "action": "openExternally"
      }
    },
    {
      // Vite 개발 서버. 저장하면 브라우저가 자동 새로고침(HMR)된다.
      // Windows 에서는 npm 이 npm.cmd 이므로 확장자까지 적는다. (macOS/Linux 는 "npm")
      "type": "node",
      "name": "프론트엔드: 실행 (Vite dev)",
      "request": "launch",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Local:.*(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      // 빌드 결과(dist)를 로컬에서 확인한다. 먼저 "frontend: 빌드" 태스크를 실행해 두어야 한다.
      "type": "node",
      "name": "프론트엔드: 미리보기 (빌드 결과)",
      "request": "launch",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "preview"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      // 백엔드와 프론트엔드를 한 번에 띄운다. (오른쪽 위 드롭다운에서 선택)
      "name": "풀스택: 백엔드 + 프론트엔드",
      "configurations": ["백엔드: 실행 (Spring Boot)", "프론트엔드: 실행 (Vite dev)"],
      "stopAll": true
    }
  ]
}
