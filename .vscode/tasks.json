{
  // 반복해서 쓰는 명령 모음. Ctrl+Shift+B(빌드 태스크 실행) 또는
  // "터미널 > 태스크 실행" 메뉴에서 고른다.
  //
  // mvnw 명령은 OS 별로 이름이 달라 windows/linux/osx 를 나눠 적었다.
  "version": "2.0.0",
  "tasks": [
    /* ── 백엔드 ─────────────────────────────────────────────── */
    {
      "label": "backend: 실행 (spring-boot:run)",
      "detail": "백엔드를 실행한다. http://localhost:8080",
      "type": "shell",
      "command": "mvnw.cmd",
      "args": ["-ntp", "spring-boot:run"],
      "windows": { "command": ".\\mvnw.cmd" },
      "linux": { "command": "./mvnw" },
      "osx": { "command": "./mvnw" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" }
    },
    {
      "label": "backend: 테스트",
      "detail": "mvnw clean test — 컨텍스트·리포지토리·API 테스트를 실행한다",
      "type": "shell",
      "command": "mvnw.cmd",
      "args": ["-ntp", "clean", "test"],
      "windows": { "command": ".\\mvnw.cmd" },
      "linux": { "command": "./mvnw" },
      "osx": { "command": "./mvnw" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" }
    },
    {
      "label": "backend: 빌드 (jar)",
      "detail": "mvnw clean package — target/godsse-backend-0.0.1-SNAPSHOT.jar 생성",
      "type": "shell",
      "command": "mvnw.cmd",
      "args": ["-ntp", "clean", "package"],
      "windows": { "command": ".\\mvnw.cmd" },
      "linux": { "command": "./mvnw" },
      "osx": { "command": "./mvnw" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" }
    },
    /* ── 프론트엔드 ─────────────────────────────────────────── */
    {
      "label": "frontend: 의존성 설치",
      "detail": "npm install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "frontend" }
    },
    {
      "label": "frontend: 실행 (dev)",
      "detail": "Vite 개발 서버 — http://localhost:5173",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "frontend" }
    },
    {
      "label": "frontend: 빌드",
      "detail": "vite build — frontend/dist 생성",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "frontend" }
    },
    {
      "label": "frontend: 포맷 (Prettier)",
      "detail": "npm run format",
      "type": "shell",
      "command": "npm run format",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "frontend" }
    },
    {
      "label": "frontend: 린트 (ESLint)",
      "detail": "npm run lint",
      "type": "shell",
      "command": "npm run lint",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "frontend" }
    },
    /* ── 묶음 작업 ──────────────────────────────────────────── */
    {
      "label": "검증: 프론트엔드 (포맷 → 린트 → 빌드)",
      "detail": "커밋 전 프론트엔드 점검",
      "dependsOrder": "sequence",
      "dependsOn": ["frontend: 포맷 (Prettier)", "frontend: 린트 (ESLint)", "frontend: 빌드"],
      "problemMatcher": []
    },
    {
      "label": "검증: 백엔드 (테스트)",
      "detail": "커밋 전 백엔드 점검",
      "dependsOn": ["backend: 테스트"],
      "problemMatcher": []
    }
  ]
}
